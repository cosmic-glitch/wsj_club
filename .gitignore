# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local PDF drop-zone — the raw WSJ exports live here; the skill copies
# the day's file to public/pdfs/YYYY-MM-DD.pdf (which IS committed/served).
/PDFs/

# local article-text drop-zone — the full plain text of each day's article.
# NEVER committed (this repo is public; don't republish WSJ text). It's uploaded
# to private Vercel Blob via scripts/upload-article-text.mjs for the voice quiz.
/article-text/

# local test artifacts (browser screenshots from the wsj-reading skill)
/index.png
/reading.png
/quiz-result.png
.playwright-mcp/
